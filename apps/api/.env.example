PORT=3000

# Local development (docker compose). Dev-only credentials.
DATABASE_URL="postgresql://helpy:helpy@localhost:5433/helpy"
DIRECT_URL="postgresql://helpy:helpy@localhost:5433/helpy"

# Production (Supabase): see docs/DEPLOY.md
# DATABASE_URL = transaction pooler, port 6543, used by the API at runtime
# DIRECT_URL   = session pooler, port 5432, used by `prisma migrate` and the seed

# Comma-separated list of front-end origins allowed to call the API
CORS_ORIGINS="http://localhost:5173"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me"

# First admin, created by `npm run db:seed`
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@helpy.local"
SEED_ADMIN_PASSWORD="replace-me-with-at-least-8-chars"

# Login/register rate limit (per IP, in memory, per instance). Set to "true" to turn it off.
# THROTTLE_DISABLED="true"

# Number of trusted proxy hops in front of the API (so the limiter sees the real client IP).
# Absent = trust none. On Vercel the right value can only be confirmed by testing the
# published URL (send requests from two IPs and check that they are counted separately).
# TRUST_PROXY=1
